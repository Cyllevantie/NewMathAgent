      "fallback": "small_multiples",
      "implemented": "studio.profile_panel",
      "category": "field-and-3d-core"
    },
    {
      "id": "small_multiples",
      "family": "profile",
      "data_shape": "facet: group × x -> y",
      "required_fields": [
        "x",
        "series",
        "facet"
      ],
      "when": "序列多、共享坐标比较形状；比一张拥挤的折线图清楚",
      "avoid": "只有 2–3 条序列时",
      "fallback": "profiles",
      "implemented": "studio.small_multiples",
      "category": "comparison-and-composition"
    },
    {
