{
  "schema_version": 1,
  "template": "zh/cumcm-latex",
  "label": "国赛（CUMCM 电子版）",
  "description": "CUMCM 电子版：中文编号、无目录页、AI 说明、正文末页支撑材料清单。",
  "roles": {
    "title": {
      "label": "论文标题",
      "placement": "block",
      "block": "blocks/title.tex",
      "required": true,
      "disablable": false,
      "numbering": "unnumbered",
      "pinned": "first",
      "page_kind": null,
      "shares_page_with": "abstract",
      "source_headings": [],
      "emitted_headings": [],
      "deliverables": [],
      "marker": "\\papertitle"
    },
    "abstract": {
      "label": "摘要",
      "placement": "block",
      "block": "blocks/abstract.tex",
      "required": true,
      "disablable": false,
      "numbering": "unnumbered",
      "pinned": "after:title",
      "page_kind": "abstract",
      "shares_page_with": "title",
      "source_headings": [],
      "emitted_headings": ["摘要"],
      "deliverables": [],
      "marker": "\\abstractcn"
    },
    "restatement": {
      "label": "问题重述",
      "placement": "file",
      "file": "sections/1_restatement.tex",
      "required": true,
      "disablable": false,
      "mode": "section",
      "numbering": "section",
      "page_kind": "body",
      "source_headings": ["问题重述", "问题背景", "问题提出"],
      "emitted_headings": []
    },
    "analysis": {
      "label": "问题分析",
      "placement": "file",
      "file": "sections/2_analysis.tex",
      "required": true,
      "disablable": false,
      "mode": "section",
      "numbering": "section",
      "page_kind": "body",
      "source_headings": ["问题分析"],
      "source_headings_after": ["本文主要创新点"],
      "repeat": {
        "kind": "problem",
        "count_from": "problem_count",
        "heading_pattern": "问题{N}的分析",
        "level": "subsection",
        "after": "问题分析",
        "before": "本文主要创新点",
        "in_same_file": true
      },
      "emitted_headings": []
    },
    "assumptions": {
      "label": "模型假设",
      "placement": "file",
      "file": "sections/3_assumptions.tex",
      "required": true,
      "disablable": false,
      "mode": "section",
      "numbering": "section",
      "page_kind": "body",
      "source_headings": ["模型假设"],
      "emitted_headings": []
    },
    "symbols": {
      "label": "符号说明",
      "placement": "file",
      "file": "sections/4_symbols.tex",
      "required": true,
      "disablable": false,
      "mode": "section",
      "numbering": "section",
      "page_kind": "body",
      "barrier_before": true,
      "source_headings": ["符号说明"],
      "emitted_headings": []
    },
    "model": {
      "label": "模型的建立与求解",
      "placement": "file",
      "wrapper_block": "blocks/model_section.tex",
      "file_pattern": "sections/5_problem{N}.tex",
      "required": true,
      "disablable": false,
      "mode": "section",
      "numbering": "section",
      "page_kind": "body",
      "wrapper_headings": ["模型的建立与求解"],
      "repeat": {
        "kind": "problem",
        "count_from": "problem_count",
        "heading_pattern": "问题{N}的模型的建立和求解",
        "level": "subsection",
        "source_subheadings": ["具体分析", "模型准备", "模型建立", "模型求解"],
        "optional_subheadings": ["结果分析"]
      },
      "emitted_headings": []
    },
    "check": {
      "label": "模型检验与分析",
      "placement": "file",
      "file": "sections/6_check.tex",
      "required": true,
      "disablable": false,
      "mode": "section",
      "numbering": "section",
      "page_kind": "body",
      "source_headings": ["模型检验与分析", "误差分析", "灵敏度分析"],
      "emitted_headings": []
    },
    "evaluation": {
      "label": "模型的评价与推广",
      "placement": "file",
      "file": "sections/7_evaluation.tex",
      "required": true,
      "disablable": false,
      "mode": "section",
      "numbering": "section",
      "page_kind": "body",
      "source_headings": ["模型的评价与推广", "模型的优点", "模型的缺点", "模型的改进与推广"],
      "emitted_headings": []
    },
    "ai_statement": {
      "label": "AI 工具使用说明",
      "placement": "block",
      "block": "blocks/ai_statement.tex",
      "required": true,
      "disablable": true,
      "numbering": "section",
      "page_kind": "ai_statement",
      "source_headings": [],
      "emitted_headings": ["AI 工具使用说明"],
      "deliverables": ["AI工具使用详情.pdf"],
      "marker": "\\section{AI 工具使用说明}"
    },
    "references": {
      "label": "参考文献",
      "placement": "block",
      "block": "blocks/references.tex",
      "file": "references.tex",
      "required": true,
      "disablable": false,
      "numbering": "section",
      "page_kind": "references",
      "shares_page_with": "ai_statement",
      "source_headings": [],
      "emitted_headings": ["参考文献"],
      "marker": "\\referencescn"
    },
    "materials_list": {
      "label": "支撑材料清单",
      "placement": "block",
      "block": "blocks/materials_list.tex",
      "file": "sections/A1_materials.tex",
      "required": true,
      "disablable": true,
      "numbering": "unnumbered-appendix",
      "pinned": "last",
      "page_kind": "appendix",
      "source_headings": [],
      "emitted_headings": ["附录"],
      "marker": "\\appendixAcn[支撑材料清单]{A1_materials}"
    },
    "appendix_pdf": {
      "label": "独立附录 A",
      "placement": "external",
      "project": "paper_appendix/",
      "main": "main.tex",
      "body": "sections/A_appendix.tex",
      "required": true,
      "disablable": true,
      "numbering": "appendix-A",
      "page_kind": null,
      "source_headings": [],
      "emitted_headings": [],
      "deliverables": ["附录A.pdf"]
    }
  }
}
