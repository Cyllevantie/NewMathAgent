{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "figure-brief.schema.json",
  "title": "FigureBrief",
  "description": "画之前必须先写的图意契约。它锁定 claim、数据形状、面板角色和统计口径；图型可以换，claim 不能悄悄换。",
  "type": "object",
  "required": [
    "figure_id",
    "question",
    "claim",
    "language",
    "width_mm",
    "archetype",
    "data",
    "panels",
    "statistics",
    "fallbacks",
    "candidates"
  ],
  "properties": {
    "figure_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "question": {
      "type": "string",
      "minLength": 4
    },
    "claim": {
      "type": "string",
      "minLength": 8
    },
    "language": {
      "enum": [
        "zh",
        "en"
      ]
    },
    "template": {
      "type": "string"
    },
    "width_mm": {
      "type": "number",
      "minimum": 50,
      "maximum": 210
    },
    "height_mm": {
      "type": "number",
      "minimum": 40,
      "maximum": 250
    },
    "archetype": {
      "enum": [
        "quantitative_grid",
        "hero_evidence",
        "asymmetric_composite",
        "schematic_led",
        "plate",
        "diagnostic_strip"
      ]
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "fields",
          "unit",
          "n",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "unit": {
            "type": "string"
          },
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "enum": [
              "observed",
              "simulated",
              "derived",
              "metadata",
              "sensitivity",
              "convergence"
            ]
          },
          "exclusions": {
            "type": "string"
          },
          "source_note": {
            "type": "string"
          }
        }
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "recipe",
          "fields",
          "claim",
          "field_mapping"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]$"
          },
          "role": {
            "enum": [
              "hero",
              "effect",
              "distribution",
              "uncertainty",
              "diagnostic",
              "comparison",
              "composition",
              "mechanism",
              "sensitivity",
              "convergence",
              "context"
            ]
          },
          "recipe": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "claim": {
            "type": "string",
            "minLength": 6
          },
          "fallback": {
            "type": "string"
          },
          "field_mapping": {
            "type": "object",
            "minProperties": 1,
            "description": "required_fields -> 实际列名/字段名；例如 {'x':'r','y':'t','z':'C'}",
            "additionalProperties": {
              "type": [
                "string",
                "array"
              ]
            }
          },
          "options": {
            "type": "object",
            "description": "表现参数（level/series_labels/view/gamma 等）；不改变数据与 claim。"
          }
        }
      }
    },
    "statistics": {
      "type": "object",
      "required": [
        "interval",
        "test",
        "unit"
      ],
      "properties": {
        "interval": {
          "type": "object",
          "required": [
            "kind",
            "method"
          ],
          "properties": {
            "kind": {
              "enum": [
                "none",
                "CI",
                "SD",
                "SE",
                "range",
                "IQR",
                "prediction"
              ]
            },
            "method": {
              "type": "string"
            },
            "level": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "test": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "none",
                "descriptive",
                "hypothesis",
                "model_selection"
              ]
            },
            "name": {
              "type": "string"
            },
            "p_values": {
              "type": "boolean"
            },
            "multiple_comparison": {
              "type": "string"
            }
          }
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "paired": {
          "type": "boolean"
        },
        "n_independent": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fallbacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "condition",
          "action"
        ],
        "properties": {
          "condition": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "caption": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "description": "至少 3 个不同视觉编码的候选；不是 3 个配色。",
      "items": {
        "type": "object",
        "required": [
          "encoding",
          "recipe",
          "mapped_fields",
          "keeps",
          "hides",
          "rejected_reason"
        ],
        "properties": {
          "encoding": {
            "type": "string",
            "minLength": 3
          },
          "recipe": {
            "type": "string"
          },
          "mapped_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "keeps": {
            "type": "string"
          },
          "hides": {
            "type": "string"
          },
          "rejected_reason": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    }
  }
}
