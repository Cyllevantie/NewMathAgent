{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|PowerShell|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/runtime/hooks/fma_hook.py"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/runtime/hooks/fma_hook.py"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/runtime/hooks/fma_hook.py"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/runtime/hooks/fma_hook.py"
            ]
          }
        ]
      }
    ]
  },
  "effortLevel": "xhigh",
  "ultracode": true,
  "enableWorkflows": true,
  "maxEffortLevel": "max",
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "max"
  }
}
