{
  "schema_version": 1,
  "_note": "recipe id 是 FigureBrief.panels[].recipe 的枚举来源。implemented 指向 skills/figure-studio/scripts/studio.py 的函数；external 表示需要按 references/catalog.md 适配外部模板，不能假装已内置。",
  "recipes": [
    {
      "id": "field_heatmap",
      "family": "field",
      "data_shape": "grid: x × y -> z",
      "required_fields": [
        "x",
        "y",
        "z"
      ],
      "when": "二维场的逐格读数；行列是离散网格或需要锚定具体格点",
      "avoid": "场里有明确阈值/前沿、需要读等值线形状时",
      "fallback": "field_contour",
      "implemented": "studio.field_panel(kind='heatmap')",
      "category": "field-and-3d-core"
    },
    {
      "id": "field_contour",
      "family": "field",
      "data_shape": "grid: x × y -> z",
      "required_fields": [
        "x",
        "y",
        "z",
        "level"
      ],
      "when": "场里有阈值、干前沿、相界或分区；要突出某一层",
      "avoid": "数据是稀疏散点、没有规则网格时",
      "fallback": "field_heatmap",
      "implemented": "studio.field_panel(kind='contour')",
      "category": "field-and-3d-core"
    },
    {
      "id": "profiles",
      "family": "profile",
      "data_shape": "series: t × r -> C",
      "required_fields": [
        "x",
        "series",
