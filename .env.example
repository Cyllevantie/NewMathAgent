# 模型 API 配置（Claude Code CLI 认的就是这几个名字）
#
# 用法：把这个文件复制成同目录下的 `.env`，把值填上。驱动启动时读它，
#       子进程（每个阶段的 agent）自然继承 ⇒ **配置跟着这个仓库走**，
#       不再依赖这台机器上 Claude CLI 自己的登录与设置。
#
# 规则（`lib/web/server.py::_load_dotenv`）：
#   · 一行一条 `KEY=VALUE`；`#` 开头的整行是注释；空行忽略
#   · 允许 `export KEY=VALUE`；值两侧成对的引号会被剥掉；值里可以有 `=`
#   · **不覆盖已经存在的环境变量** —— 临时 `$env:ANTHROPIC_MODEL=...` 调试时，那个优先
#   · 坏行（没有 `=`）会跳过并在启动日志里告诉你第几行，不会让驱动起不来
#
# 这个文件里会有**密钥**：别把整个目录打包发给别人、别贴进截图或聊天。
#    要分享就用这份 `.env.example`（它是模板，没有值）。

# ---- 端点与凭据（接第三方/中转时必填前两个；不填就用 CLI 默认的官方地址）----
ANTHROPIC_BASE_URL=
# 你的密钥。**二选一**：AUTH_TOKEN 走 `Authorization: Bearer`（多数中转要这个），
# API_KEY 走 `x-api-key`（官方 API 的名字）。哪个有值用哪个，另一个留空即可。
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=

# ---- 用哪个模型（留空 = 用 CLI 默认）----
ANTHROPIC_MODEL=
# 「小/快模型」：给会话标题、快速分类这类**后台小活**用，不是主模型（可选）。
# 填了它就以它为准；不填则看下面的 `ANTHROPIC_DEFAULT_HAIKU_MODEL`。
ANTHROPIC_SMALL_FAST_MODEL=

# ---- 模型档位别名（**本项目默认不填**，见下）----
# 上面那三个就够了：主模型、子 agent、后台小活全走同一个端点上的同一个模型。
# 档位别名（CLAUDE_CODE_SUBAGENT_MODEL / ANTHROPIC_DEFAULT_{HAIKU,SONNET,OPUS,FABLE}_MODEL）
# 不填时取自**这台机器**的 `~/.claude/settings.json`（本机就是这么配的：各档位都指 deepseek）。
# 只有一种情况需要在这里补上它们：**把仓库拷到一台没有那份 settings.json 的新机器**上跑 ——
#   那时门禁并行 spawn 的**子 agent** 与后台小活会回落到 CLI 自带的**官方**模型 id
#   （那边没有官方凭据，直接失败），补一行 `CLAUDE_CODE_SUBAGENT_MODEL=<上面的模型名>` 即可。
CLAUDE_CODE_SUBAGENT_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=

# ---- claude 可执行文件在哪（留空 = 自己找）----
# 不填时驱动按顺序找：~/.vscode/extensions、~/.vscode-server/extensions、
# ~/.vscode-insiders/extensions、~/.cursor/extensions，再回退 PATH 里的 claude。
# 装在别处（或想钉死版本）时填完整路径；填了但文件不存在 ⇒ 直接报错，不会悄悄换一个。
WEBDRIVER_CLAUDE=

# ---- 出站代理：只把 API 端点摘出代理（默认 auto）----
# 症状是"梯子开着/关着时好时坏"：`claude`（Node）只读 HTTPS_PROXY 这类**环境变量**，
# 而 Python（urllib/requests）读 **Windows 系统代理**（Clash 的「系统代理」开关改的就是它）
# ⇒ 梯子一关、7897 没人听，Python 侧就是 connection refused。
# 摘出去的主机是**从 ANTHROPIC_BASE_URL 推**的，不写死任何厂商域名 —— 换端点自动跟着换。
#   auto   = 只把 API 主机摘出代理，外网搜索照旧走梯子（默认，留空也是它）
#   system = 一个字节都不改 —— 和你在终端里直接敲 `claude` 完全一致
#   off    = NO_PROXY=*，所有出站都直连（没梯子、或不想让任何东西走代理时用）
FMA_API_PROXY=auto
# 除 API 端点外还要额外直连的主机（逗号分隔），比如国内镜像站
FMA_NO_PROXY_EXTRA=

# ---- 运行参数（看门狗 / 墙钟上限）：**留空就用括号里的默认值** ----
# 换台快慢差很多的机器时才需要动；改了要重启驱动生效。
# 这些**不能**写进 config/runtime.local.json —— 那个文件被哈希进 ④ 及下游的输入指纹，
#   往里加旋钮 = 动一下就让整条链从 ④ 重跑。`.env` 不进任何阶段的指纹。
# FMA_STALL_SILENT=300        # 无输出+无连接+无CPU 连续这么久 → 判假死
# FMA_STALL_CONN=1200         # 仅有半开连接而无输出/CPU 的最长容忍
# FMA_STALL_SAMPLE=5          # 看门狗采样间隔
# FMA_RETRY_CAP_DEFAULT=1800  # 单次墙钟上限（不延长时）= 30 分钟
# FMA_RETRY_EXTRA_MAX=3600    # 一次「延长」最多追加 = 60 分钟（面板输入框的 max 也读它）
# FMA_RETRY_EXTRA_MIN=600     # 一次「延长」至少追加 = 10 分钟
# FMA_RETRY_CAP_MAX=10800     # 反复延长后的总上限天花板
# FMA_CALL_HARD_CAP=10800     # 单次 claude 调用的墙钟硬上限
# FMA_CALL_PROTOCOL_CAP=900   # 协议级修复（只补写 .verdict.json）的短上限
# FMA_WAIT_AFTER_KILL=60      # 看门狗强杀后最多再等读循环结束多久
# FMA_OVERTIME_KILL=0         # 1 = 超限时立即强杀（默认 0：转黄灯但让任务继续跑）
# FMA_AUTO_RETRY_ENV_ERROR=1  # 1 = claude 路径失效时自动重试一次（默认 1）
